              }
            ],
            "url": {
              "raw": "{{base_url}}/blogs/blog-post-1",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "blogs",
                "blog-post-1"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Media",
