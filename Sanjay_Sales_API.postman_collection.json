      ]
    },
    {
      "name": "Inquiry",
      "item": [
        {
          "name": "Submit inquiry",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Ramesh Patel\",\n  \"email\": \"ramesh@example.com\",\n  \"phone\": \"+91 98765 43210\",\n  \"subject\": \"Price of MIG welder\",\n  \"message\": \"Please share price and delivery time.\",\n  \"product_id\": 1,\n  \"website\": \"\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/inquiries",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "inquiries"
              ]
            }
          }
        }
      ]
    }
  ]
}