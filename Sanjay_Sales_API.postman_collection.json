              "host": [
                "{{base_url}}"
              ],
              "path": [
                "blogs"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "per_page",
                  "value": "6"
                }
              ]
            }
          }
        },
        {
          "name": "Blog detail",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
